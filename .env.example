# Copy to .env and adjust. Never commit .env.

# --- Database (docker-compose defaults) ---
DATABASE_URL="postgresql://erp:erp@localhost:5432/college_erp?schema=public"

# --- Auth (Phase 2) — generate with: openssl rand -base64 32 ---
AUTH_SECRET="replace-me-with-a-random-32-byte-secret"

# --- S3-compatible storage (MinIO locally, Cloudflare R2 in prod) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="college-erp-private"
S3_FORCE_PATH_STYLE="true"

# --- Seed ---
# Password given to every seeded account (they are all forced to change it on first login).
SEED_DEFAULT_PASSWORD="ChangeMe@123"

# --- Institution ---
# IANA timezone used for "today", schedules and displayed times.
APP_TIMEZONE="Asia/Kolkata"

# --- Face service (docker-compose `face`) — generate with: openssl rand -hex 32 ---
FACE_SERVICE_URL="http://localhost:8001"
FACE_SERVICE_TOKEN="replace-me-with-a-random-64-hex-char-token"
