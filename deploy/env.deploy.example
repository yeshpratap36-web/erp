# Copy to deploy/.env.deploy (git-ignored) and fill in. deploy.sh copies it to the server.
# Secrets for the database and sessions are generated on the server on first deploy.

# Public hostname — point its DNS A record at the server before deploying.
DOMAIN=erp.example.edu
# Let's Encrypt account / expiry notices.
ACME_EMAIL=it-admin@example.edu

# Private S3-compatible bucket for photos (and backups). AWS S3 example:
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_REGION=ap-south-1
S3_BUCKET=college-erp-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Cloudflare R2 instead: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto

# First administrator (created once; a temporary password is printed by the deploy).
ADMIN_LOGIN_ID=admin
ADMIN_EMAIL=admin@example.edu
ADMIN_NAME=System Administrator

APP_TIMEZONE=Asia/Kolkata

# Nightly database backups: kept on the server for this many days, and copied to the bucket
# under backups/ when BACKUP_UPLOAD=true (optionally to a separate BACKUP_S3_BUCKET).
BACKUP_RETENTION_DAYS=14
BACKUP_UPLOAD=true
# BACKUP_S3_BUCKET=college-erp-backups
